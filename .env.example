# Paystack PUBLIC key (pk_test_... while testing, pk_live_... when live).
# Leave empty to run checkout in demo mode.
VITE_PAYSTACK_PUBLIC_KEY=

# Paystack SECRET key, read only by the server function in api/verify.ts.
# On Vercel, set it in the project's environment variables, not in a file.
# Needed locally only when running `npx vercel dev`.
PAYSTACK_SECRET_KEY=
